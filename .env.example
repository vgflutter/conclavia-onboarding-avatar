# Reuse the existing Mongo installation. Never point this at a new empty replacement.
MONGODB_URI=
MONGODB_DB_NAME=
ONBOARDING_BASE_URL=http://localhost:3002
# Generate local credentials with npm run setup:local.
ONBOARDING_ADMIN_TOKEN=
ONBOARDING_SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_ONBOARDING_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
INWORLD_API_KEY=
INWORLD_TTS_MODEL=inworld-tts-2-flash
INWORLD_VOICE_ID_IT=Gianni
INWORLD_VOICE_ID=Dennis
# No provider calls in automated tests. Real media is explicitly started in the UI.
ONBOARDING_AI_ENABLED=true
